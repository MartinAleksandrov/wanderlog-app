{
  "expo": {
    "name": "Wandr",
    "slug": "wandr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wandr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "io.github.martinaleksandrov.wandr",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/withNetskopeDebugTrust",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wandr shows how far places are from you.",
          "motionUsagePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# react-native-maps pulls in WorkManager, which ships Room 2.5. Room creates its generated databases by reflection, and R8 full mode strips their constructors under Room 2.5's own keep rule, so release builds crash on launch.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0f681565-658c-4ba7-a038-4ba851449653"
      }
    },
    "owner": "martsexpo"
  }
}
